#!/bin/bash

domain=${1:-builds.roflmao.space}

Ximages=(
	amd64:systemd:stage3
	amd64:systemd:stage4
)

Aimages=(
	armv7a:hardfp:stage3
	armv7a:hardfp:stage4
)

Simages=(
	armv7a:systemd:stage3
	armv7a:systemd:stage4
)

image_import() {
	docker image inspect "$2" || docker image import "$@"
}

for i in ${Ximages[*]}; do
	arch=$(cut -d: -f1 <<<"$i")
	build=$(cut -d: -f2 <<<"$i")
	stage=$(cut -d: -f3 <<<"$i")

	relative=$(curl -s "https://$domain/$arch/$build/latest-$stage-$arch-$build.txt")
	bdate=$(dirname "$relative")
	fullpath="https://$domain/$arch/$build/$relative"

	image_import "$fullpath" "applehq/roflmaos-$stage:$arch-$bdate"
	docker image tag "applehq/roflmaos-$stage:$arch-$bdate" "applehq/roflmaos-$stage:$arch-latest"
	docker image tag "applehq/roflmaos-$stage:$arch-$bdate" "applehq/roflmaos-$stage:latest"
done

for i in ${Aimages[*]}; do
	arch=$(cut -d: -f1 <<<"$i")
	build=$(cut -d: -f2 <<<"$i")
	stage=$(cut -d: -f3 <<<"$i")

	relative=$(curl -s "https://$domain/$arch/$build/latest-$stage-${arch}_${build}.txt")
	bdate=$(dirname "$relative")
	fullpath="https://$domain/$arch/$build/$relative"

	image_import "$fullpath" "applehq/roflmaos-$stage:$arch-$bdate"
	docker image tag "applehq/roflmaos-$stage:$arch-$bdate" "applehq/roflmaos-$stage:$arch-latest"
done

for i in ${Simages[*]}; do
	arch=$(cut -d: -f1 <<<"$i")
	build=$(cut -d: -f2 <<<"$i")
	stage=$(cut -d: -f3 <<<"$i")

	relative=$(curl -s "https://$domain/$arch/$build/latest-$stage-${arch}_hardfp-${build}.txt")
	bdate=$(dirname "$relative")
	fullpath="https://$domain/$arch/$build/$relative"

	image_import "$fullpath" "applehq/roflmaos-$stage:$arch-$bdate"
	docker image tag "applehq/roflmaos-$stage:$arch-$bdate" "applehq/roflmaos-$stage:$arch-latest"
done
